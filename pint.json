{
    "preset": "laravel",
    "rules": {
        "concat_space": false,
        "nullable_type_declaration_for_default_null_value": true,
        "simplified_null_return": true,
        "braces": false,
        "new_with_braces": {
            "anonymous_class": false,
            "named_class": false
        }
    }
}
